{
  // VS Code 启动配置 — Auroweave (Tauri v2 + Vue 3)
  "version": "0.2.0",
  "configurations": [
    // ================================================================
    // 1. Tauri Dev — 完整开发模式 (Vite 热更新 + Rust 编译 + Tauri 窗口)
    //    无需额外扩展，直接在终端中启动
    // ================================================================
    {
      "type": "node-terminal",
      "name": "Tauri Dev",
      "request": "launch",
      "command": "npm run tauri dev",
      "cwd": "${workspaceFolder}"
    },

    // ================================================================
    // 2. 前端调试 (Edge) — 在 Edge 浏览器中调试 Vue 组件源码
    //    需先运行任务 frontend:dev 或手动 npm run dev
    //    Edge 调试器内置于 VS Code，无需安装额外扩展
    // ================================================================
    {
      "type": "msedge",
      "request": "launch",
      "name": "Vue Frontend (Edge)",
      "url": "http://localhost:1420",
      "webRoot": "${workspaceFolder}/src",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    },

    // ================================================================
    // 3. 前端调试 (Chrome) — 在 Chrome 浏览器中调试 Vue 组件源码
    //    需先运行任务 frontend:dev 或手动 npm run dev
    //    需安装扩展: msjsdiag.debugger-for-chrome
    // ================================================================
    {
      "type": "chrome",
      "request": "launch",
      "name": "Vue Frontend (Chrome)",
      "url": "http://localhost:1420",
      "webRoot": "${workspaceFolder}/src",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./src/*": "${webRoot}/*",
        "webpack:///src/*": "${webRoot}/*"
      },
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
