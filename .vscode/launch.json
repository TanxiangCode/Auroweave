{
  // VS Code 启动配置 — Auroweave (Tauri v2 + Vue 3)
  // 使用 IntelliSense 了解相关属性。
  // 悬停查看现有属性的描述。
  "version": "0.2.0",
  "configurations": [
    // ================================================================
    // 1. Tauri Dev (Rust + 前端) — 完整开发调试
    //    启动 Vite 开发服务器 + 编译 Rust 调试版本 + 拉起 Tauri 窗口
    //    依赖扩展: CodeLLB (vadimcn.vscode-lldb)
    // ================================================================
    {
      "type": "lldb",
      "request": "launch",
      "name": "Tauri Dev Debug",
      "cargo": {
        "args": ["build", "--manifest-path=src-tauri/Cargo.toml", "--no-default-features"]
      },
      "preLaunchTask": "tauri:dev",
      "program": "${workspaceFolder}/src-tauri/target/debug/auroweave.exe",
      "cwd": "${workspaceFolder}/src-tauri",
      "env": {
        "RUST_LOG": "debug"
      }
    },

    // ================================================================
    // 2. Tauri Build (Release) — 发布版本调试
    //    编译 Release 版本并启动（用于排查仅 Release 出现的问题）
    // ================================================================
    {
      "type": "lldb",
      "request": "launch",
      "name": "Tauri Release Debug",
      "cargo": {
        "args": ["build", "--manifest-path=src-tauri/Cargo.toml", "--release"]
      },
      "program": "${workspaceFolder}/src-tauri/target/release/auroweave.exe",
      "cwd": "${workspaceFolder}/src-tauri",
      "env": {
        "RUST_LOG": "info"
      }
    },

    // ================================================================
    // 3. 前端调试 (Chrome) — 在浏览器中调试 Vue 组件
    //    先手动运行 `npm run dev`，然后用 Chrome 调试 Vue 源码
    //    依赖扩展: Debugger for Chrome (msjsdiag.debugger-for-chrome)
    // ================================================================
    {
      "type": "chrome",
      "request": "launch",
      "name": "Vue Frontend (Chrome)",
      "url": "http://localhost:1420",
      "webRoot": "${workspaceFolder}/src",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./src/*": "${webRoot}/*",
        "webpack:///src/*": "${webRoot}/*"
      },
      "skipFiles": ["<node_internals>/**"]
    },

    // ================================================================
    // 4. 前端调试 (Edge) — 在 Edge 浏览器中调试 Vue 组件
    // ================================================================
    {
      "type": "msedge",
      "request": "launch",
      "name": "Vue Frontend (Edge)",
      "url": "http://localhost:1420",
      "webRoot": "${workspaceFolder}/src",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
