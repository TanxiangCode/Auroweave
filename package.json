{
  "name": "auroweave",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:svc": "cargo clean -p auroweave-svc && cargo build -p auroweave-svc && node -e \"fs.copyFileSync('target/debug/AuroDaemon.exe', 'src-tauri/resources/AuroDaemon.exe')\"",
    "uninstall:svc": "powershell -Command \"Start-Process -FilePath 'target/debug/AuroDaemon.exe' -ArgumentList 'uninstall' -Verb RunAs -Wait\"",
    "preview": "vite preview",
    "tauri": "tauri dev",
    "lint": "eslint . --ext .vue,.ts,.tsx --fix",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2",
    "@vueuse/core": "^14.3.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^2.1.10"
  }
}
