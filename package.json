{
  "name": "auroweave",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:svc": "cargo clean && cargo build && node -e \"fs.copyFileSync('target/debug/AuroDaemon.exe', 'src-tauri/resources/AuroDaemon.exe')\"",
    "uninstall:svc": "powershell -Command \"Start-Process -FilePath 'target/debug/AuroDaemon.exe' -ArgumentList 'uninstall' -Verb RunAs -Wait\"",
    "preview": "vite preview",
    "tauri": "tauri dev",
    "build:installer": "tauri build",
    "build:install": "tsx scripts/build-install.ts",
    "version:check": "tsx scripts/version-sync.ts",
    "version:set": "tsx scripts/version-sync.ts",
    "lint": "eslint . --fix",
    "test:unit": "vitest run",
    "download:sing-box": "tsx scripts/download-singbox.ts",
    "update:sing-box_docs": "npx degit SagerNet/sing-box/docs/configuration#testing docs/sing-box_docs --force"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.0",
    "@vueuse/core": "^14.3.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "happy-dom": "^20.0.0",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^2.1.10"
  }
}
