{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auroweave",
  "version": "0.1.0",
  "identifier": "com.auroweave.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Auroweave",
        "width": 1020,
        "height": 680,
        "minWidth": 1020,
        "minHeight": 640,
        "decorations": false,
        "transparent": true,
        "center": true,
        "resizable": true,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/tray-icon.png",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "sidecar-bin/": "sidecar-bin/"
    }
  }
}
